# Optional Discord alert webhooks used by monitor scripts.
DISCORD_MONITOR_WARNING_WEBHOOK_URL=
DISCORD_MONITOR_CRITICAL_WEBHOOK_URL=
# Optional. Defaults to DISCORD_MONITOR_CRITICAL_WEBHOOK_URL so firing/recovery pairs stay together.
DISCORD_MONITOR_RECOVERY_WEBHOOK_URL=

# Default paths on the NUC.
NUC_WEB_ROOT=/opt/nuc-web
HOME_SERVER_CONFIG=/opt/nuc-web/config/sites.yaml
HOME_SERVER_ENV_FILE=/opt/nuc-web/.env
HOME_SERVER_STATE_DIR=/var/lib/home-server

# Gateway monitor timer cadence.
HOME_SERVER_MONITOR_ON_BOOT_SEC=2min
HOME_SERVER_MONITOR_INTERVAL=5min

# Health check behavior.
HEALTH_TIMEOUT_MS=5000
# Set to true for first install if public DNS/Tunnel routes are not ready yet.
HOME_SERVER_SKIP_PUBLIC_HEALTH_CHECKS=false

# Cron monitor behavior.
HOME_SERVER_SKIP_CRON_CHECKS=false
HOME_SERVER_SKIP_CRON_DAEMON_CHECK=false
# Default freshness window for configured cron log files when a job omits maxAgeMinutes.
HOME_SERVER_CRON_MAX_AGE_MINUTES=1500
# Number of bytes read from the end of each configured cron log file.
HOME_SERVER_CRON_LOG_TAIL_BYTES=65536

# Optional override when installing generated Cloudflare Tunnel config.
CLOUDFLARED_CONFIG_FILE=/etc/cloudflared/config.yml

# External uptime monitor, intended to run from a non-NUC host such as a DigitalOcean droplet.
# It reads config/sites.yaml and checks enabled publicHealthChecks only.
HOME_SERVER_EXTERNAL_MONITOR_STATE_FILE=/var/lib/home-server-external-monitor/state.json
HOME_SERVER_EXTERNAL_MONITOR_TIMEOUT_MS=10000
HOME_SERVER_EXTERNAL_MONITOR_USER_AGENT=home-server-external-uptime-monitor/1.0
# Optional override; otherwise DISCORD_MONITOR_CRITICAL_WEBHOOK_URL / RECOVERY / WARNING are reused.
# DISCORD_EXTERNAL_MONITOR_CRITICAL_WEBHOOK_URL=
# DISCORD_EXTERNAL_MONITOR_RECOVERY_WEBHOOK_URL=
# DISCORD_EXTERNAL_MONITOR_WARNING_WEBHOOK_URL=

# Authenticated synthetic monitoring for Community Bank Pilot.
CBP_SYNTHETIC_BASE_URL=https://communitybankpilot.com
CBP_SYNTHETIC_TENANT_SLUG=
CBP_SYNTHETIC_TENANT_URL=
CBP_SYNTHETIC_EMAIL=
CBP_SYNTHETIC_PASSWORD=
CBP_SYNTHETIC_EXPECT_DASHBOARD_TEXT=Executive command center
CBP_SYNTHETIC_READ_ONLY_PATHS=/reports/balance-sheet,/reports/income-statement,/reports/packages,/reports/import
CBP_SYNTHETIC_TIMEOUT_MS=30000
CBP_SYNTHETIC_HEADLESS=true
CBP_SYNTHETIC_STATE_FILE=/var/lib/home-server-synthetic-monitor/cbp-authenticated-smoke-state.json
CBP_SYNTHETIC_SCREENSHOT_DIR=/var/log/home-server-synthetic-monitor
DISCORD_SYNTHETIC_MONITOR_CRITICAL_WEBHOOK_URL=
DISCORD_SYNTHETIC_MONITOR_RECOVERY_WEBHOOK_URL=
DISCORD_SYNTHETIC_MONITOR_WARNING_WEBHOOK_URL=
