{
  "name": "home-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "validate:sites": "node scripts/validate-sites-config.mjs",
    "render:nginx": "node scripts/render-nginx-config.mjs",
    "render:cloudflared": "node scripts/render-cloudflared-config.mjs",
    "static:deploy": "node scripts/deploy-static-site.mjs",
    "static:list": "node scripts/list-static-releases.mjs",
    "static:rollback": "node scripts/rollback-static-site.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "pnpm format && pnpm lint:md && pnpm lint:shell && pnpm validate:sites && pnpm render:nginx && pnpm render:cloudflared",
    "validate:check": "pnpm format:check && pnpm lint:md && pnpm lint:shell && pnpm validate:sites && pnpm render:nginx && pnpm render:cloudflared",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "lint:shell": "bash scripts/lint-shell.sh",
    "heartbeat:supabase": "bash scripts/run-supabase-heartbeat.sh",
    "setup:sftp": "sudo bash scripts/setup-cbp-sftp.sh",
    "monitor:external": "node scripts/external-uptime-monitor.mjs",
    "install:external-monitor": "sudo bash scripts/install-external-uptime-monitor.sh",
    "monitor:synthetic:cbp": "node scripts/synthetic/cbp-authenticated-smoke.mjs",
    "install:synthetic-monitor": "sudo bash scripts/install-cbp-synthetic-monitor.sh"
  },
  "dependencies": {
    "yaml": "^2.8.1",
    "playwright": "^1.54.2"
  },
  "devDependencies": {
    "markdownlint-cli2": "^0.18.1",
    "prettier": "^3.6.2",
    "prettier-plugin-sh": "^0.18.0"
  }
}
